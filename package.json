{
  "name": "wam3dgenerator",
  "private": true,
  "version": "0.0.11",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5172",
    "expose": "vite dev --port 5172 --host",
    "build": "tsc && vite build",
    "test": "npm run lib && node --test test/legacy-example-compatibility.test.mjs test/v2-descriptor-contract.test.mjs test/thumbnail-reference.test.mjs test/editor-interactions.test.mjs test/document-history.test.mjs test/face-transform.test.mjs test/widget-catalog.test.mjs",
    "preview": "vite preview",
    "lib": "vite build -c vite_lib.config.js",
    "postinstall": "npm run lib"
  },
  "devDependencies": {
    "typescript": "~5.7.2"
  },
  "dependencies": {
    "@babylonjs/core": "^8.24.0",
    "@webaudiomodules/api": "^2.0.0-alpha.6",
    "@webaudiomodules/sdk": "^0.0.12",
    "dockview-core": "^4.2.1",
    "earcut": "^3.0.1",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.3"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  }
}
